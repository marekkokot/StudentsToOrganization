<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Students Management</title>
    @Styles.Render("~/Content/css")
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("AddToHead", required: false)
</head>
<body>
    @Html.Action("CourseName")


    <div class="MenuContainer">
        <div>
            <ul id="nav">
                <li>@Html.ActionLink("Dodaj studenta", "Index")</li>
                <li>@Html.ActionLink("Dodaj wielu z pliku CSV", "AddFromCSV")</li>
                <li>@Html.ActionLink("Copy dir from repo to another", "RepoToRepo")</li>
                <li>@Html.ActionLink("Create Issue", "CreateIssue")</li>
                <li>@Html.ActionLink("Manage Repos", "ManageRepositories")</li>
            </ul>
        </div>
        <div class="mainContent">
            @RenderBody()
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script src="~/scripts/menu.js"></script>
</body>
</html>
